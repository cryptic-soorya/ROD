JWT_SECRET=replace-with-a-long-random-string
# MCP_JWT_SECRET must be the SAME value as JWT_SECRET above — auth/jwt_handler.py
# signs agent tokens (generate_agent_token) with JWT_SECRET, and
# mcp_server/auth_middleware.py verifies MCP_AUTH_TOKEN's signature with
# MCP_JWT_SECRET. They're two env var names for one shared secret.
MCP_JWT_SECRET=replace-with-a-long-random-string
# Agent service token — mint with auth.jwt_handler.generate_agent_token(
#   agent_id, scopes=["read:sales","read:inventory","read:returns",
#   "read:customers","read:promotions","read:suppliers","read:knowledge"])
MCP_AUTH_TOKEN=
# ANTHROPIC_API_KEY=replace-with-your-key  # currently unused — agent/react_loop.py calls Gemini, not Anthropic
GEMINI_API_KEY=replace-with-your-key
DB_PATH=./mcp_server/db/
CHROMA_DB_PATH=./knowledge_base/chroma_db/
KNOWLEDGE_SAMPLE_MIN=10
